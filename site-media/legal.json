{"legal": "<style>\n.np .lg-tabs{position:sticky;top:0;z-index:3;background:rgba(13,13,13,.92);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid #1f1f1d}\n.np .lg-tabs .in{max-width:1200px;margin:0 auto;padding:12px clamp(20px,6vw,72px);display:flex;gap:8px;overflow-x:auto;scrollbar-width:none}\n.np .lg-tabs .in::-webkit-scrollbar{display:none}\n.np .lg-tabs button{flex:none;min-height:44px;padding:0 18px;border-radius:999px;border:1px solid #272725;background:transparent;color:#C9C5BC;font:inherit;font-size:14px;cursor:pointer;transition:background-color .2s,color .2s,border-color .2s,transform .15s}\n.np .lg-tabs button:hover{border-color:#3a3a37;color:#F3F0EA}\n.np .lg-tabs button:active{transform:scale(.97)}\n.np .lg-tabs button.on{background:#F3F0EA;color:#0D0D0D;border-color:#F3F0EA}\n.np .lg-meta{display:inline-flex;align-items:center;gap:10px;margin-top:24px;padding:8px 16px;border-radius:999px;background:#151514;border:1px solid #272725;font-size:13px;color:#9C998F}\n.np .lg-meta i{width:8px;height:8px;border-radius:50%;background:#4FA38A;display:inline-block}\n.np .lg{display:grid;grid-template-columns:260px minmax(0,1fr);gap:40px;padding:48px 0;border-top:1px solid #1f1f1d;scroll-margin-top:80px}\n.np .lg:first-child{border-top:0}\n.np .lg .lh .no{font-size:56px;line-height:1;color:#2f2f2c;font-weight:300}\n.np .lg .lh .en{display:block;margin-top:14px;font-size:12px;letter-spacing:3px;color:#D4503F;text-transform:uppercase}\n.np .lg .lh h2{margin:10px 0 0;font-size:clamp(24px,2.4vw,30px);font-weight:600;color:#F3F0EA}\n.np .lg .lb p{margin:0 0 16px;font-size:16px;line-height:1.95;color:#C9C5BC}\n.np .lg .lb p:last-child{margin-bottom:0}\n.np .lg .lb ol{list-style:none;counter-reset:i;margin:4px 0 20px;padding:0;display:grid;gap:10px}\n.np .lg .lb ol li{counter-increment:i;display:flex;gap:16px;align-items:flex-start;padding:16px 20px;border-radius:18px;background:#151514;border:1px solid #272725;font-size:15px;line-hei